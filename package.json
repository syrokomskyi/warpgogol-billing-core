{
  "name": "@warpgogol/warpgogol-billing-core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Provider-neutral billing read projection contracts, schemas, and kernel commands.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./kernel": {
      "types": "./src/kernel/index.ts",
      "default": "./src/kernel/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    },
    "./ports": {
      "types": "./src/billing-store.ts",
      "default": "./src/billing-store.ts"
    },
    "./usage": {
      "types": "./src/usage-metering.ts",
      "default": "./src/usage-metering.ts"
    }
  },
  "files": [
    "dist/",
    "src/index.ts",
    "src/schemas/",
    "src/billing-store.ts",
    "src/billing-revision.ts",
    "src/in-memory-billing-store.ts",
    "src/commands/",
    "src/kernel/",
    "src/kernel-module.ts",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "check": "pnpm run build:check && pnpm run test",
    "lint": "pnpm exec eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@warpgogol/werkstatt-engine": "^1.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.10.0"
}
